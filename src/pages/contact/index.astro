---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Nawtch"
  description="Get in touch with Nawtch for feature requests, bug reports, or partnership inquiries."
  canonicalPath="/contact/"
  bodyClass="privacy"
  ads="rail"
>
  <header>
    <div class="header-left">
      <h1>Contact</h1>
      <p class="subtitle">We'd love to hear from you.</p>
    </div>
    <a class="ghost-btn" href="#" onclick="window.history.back(); return false;">← Back</a>
  </header>

  <div class="settings-section">
    <div class="settings-section-body">
      <p class="settings-desc">
        Got a feature request, found a bug, or interested in a partnership? Reach out anytime at <a href="mailto:team@nawtch.app">team@nawtch.app</a>
      </p>
      <p class="settings-desc">
        We will respond to your message as soon as possible.
      </p>
    </div>
  </div>
</BaseLayout>
