---
// Header "← Back" link. Goes back in history only when the previous page was
// another Nawtch page; direct visits, search results, and external links fall
// through to the homepage. href="/" keeps it working without JS and gives
// crawlers a real link instead of "#".
interface Props {
  style?: string;
}

const { style } = Astro.props;
---

<a
  class="ghost-btn"
  href="/"
  style={style}
  onclick="if (history.length > 1 && document.referrer.indexOf(location.origin + '/') === 0) { history.back(); return false; }"
>← Back</a>
